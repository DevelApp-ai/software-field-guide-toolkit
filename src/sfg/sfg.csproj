    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sfg</ToolCommandName>
    <PackageId>Sfg.Tool</PackageId>
    <Version>0.2.0</Version>
    <Authors>DevelApp.ai</Authors>
    <Description>Software Field Guide companion tools: code-truth context mapper (#54), seam ledger (#55), and tenant-isolation probe generator (#58).</Description>
